{
  "name": "azalais-dark-theme",
  "displayName": "Azalais Dark",
  "description": "Dark theme made to reduce eye fatigue for Visual Studio Code",
  "version": "0.0.17",
  "publisher": "ChristopherAlphonse",
  "license": "MIT",
  "homepage": "https://github.com/ChristopherAlphonse/azalais-dark-theme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChristopherAlphonse/azalais-dark-theme"
  },
  "bugs": {
    "url": "https://github.com/ChristopherAlphonse/azalais-dark-theme/issues"
  },
  "icon": "icon.png",
  "keywords": [
    "theme",
    "azalais",
    "azalais theme",
    "azalais dark",
    "christopher alphonse",
    "dark theme",
    "eye fatigue",
    "color blind",
    "tritanopia",
    "deuteranopia",
    "protanopia",
    "focus",
    "minimal",
    "color theme",
    "dark"
  ],
  "galleryBanner": {
    "color": "#000058",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.72.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Azalais",
        "uiTheme": "vs-dark",
        "path": "./themes/Azalais-Classic.json"
      },
      {
        "label": "Azalais Glow",
        "uiTheme": "vs-dark",
        "path": "./themes/Azalais-Glow.json"
      }
    ]
  },
  "scripts": {
    "package": "vsce package -o azalais-dark-theme.vsix",
    "release": "gh workflow run publish.yml --ref main -f bump=patch && sleep 3 && gh run watch $(gh run list --workflow publish.yml --limit 1 --json databaseId -q '.[0].databaseId')",
    "release:minor": "gh workflow run publish.yml --ref main -f bump=minor",
    "release:major": "gh workflow run publish.yml --ref main -f bump=major"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.1"
  },
  "pricing": "Free"
}
